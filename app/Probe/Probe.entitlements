<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  TIER 0 — no entitlements that require a provisioned capability.
	  Everything the app does at this tier is gated only by Info.plist
	  usage strings and a runtime permission prompt. This variant should
	  sign with a free Apple ID under any circumstances; if it does not,
	  the problem is the toolchain, not the capability set.
	-->
	<key>get-task-allow</key>
	<false/>
</dict>
</plist>
